(define (problem Jaco_Custom_Tabletop_Task_1)
  (:domain robosuite)
  (:language Pick the akita black bowl next to the plate)
    (:regions
      (plate_region
          (:target main_table)
          (:ranges (
              (-0.29 -0.25 -0.27 -0.23)
            )
          )
      )
      (next_to_plate_region
          (:target main_table)
          (:ranges (
              (-0.25 0.05 -0.23 0.07)
            )
          )
      )
      (table_center
          (:target main_table)
          (:ranges (
              (0.13 -0.12 0.15 -0.10)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 akita_black_bowl_2 - large_akita_black_bowl
    plate_1 - large_plate
  )

  (:obj_of_interest
    akita_black_bowl_1
    plate_1
  )

  (:init
    (On akita_black_bowl_1 main_table_next_to_plate_region)
    (On akita_black_bowl_2 main_table_table_center)
    (On plate_1 main_table_plate_region)
  )

  (:goal
    (True)
  )

)
